{
  "name": "blueberry",
  "productName": "Blueberry",
  "private": true,
  "version": "0.8.5",
  "description": "桌面应用，用于抓取、过滤和分析 arXiv 论文及会议论文，支持 LLM 总结与深度分析",
  "author": "Blueberry Developer",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && node scripts/copy-assets.js && electron .",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && vite build && tsc -b tsconfig.node.json && node scripts/copy-assets.js",
    "package": "npm run build && electron-builder",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:main",
    "test": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "dompurify": "^3.4.3",
    "katex": "^0.16.46",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.3",
    "pdf-parse": "^2.4.5",
    "pinia": "^3.0.4",
    "sql.js": "^1.14.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  }
}
